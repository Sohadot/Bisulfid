{
  "version": "1.0.0",
  "sprint": "6B",
  "site": "bisulfid.com",
  "governed_by": "main/data/corpus_production_rules.md",
  "status": "codified",
  "scope_amendment": "reference_layer_architecture",
  "reference_layers": [
    {
      "reference_layer_id": "REF_ACADEMIC",
      "reference_layer_code": "academic",
      "name": "Academic reference",
      "purpose": "Academically credible reference material with citation-aware structure and terminology precision.",
      "target_users": ["researchers", "chemists", "students_advanced"],
      "allowed_page_families": ["PT_TERM_CANONICAL", "PT_COMPOUND_ENTITY", "PT_SOURCE_BOUND", "PT_CLAIM_BOUNDARY", "PT_DIFFERENCE_COMPARISON", "PT_AI_READABLE"],
      "required_source_posture": "source_verified",
      "required_claim_posture": "claim_approved_narrow",
      "allowed_content_classes": ["terminology", "citation", "source_hierarchy", "dictionary_vs_database_distinction", "nomenclature_context"],
      "forbidden_content_classes": ["unsupported_claims", "AI_summary_as_source", "universal_rules_without_authority", "medical", "safety_prescriptive"],
      "seo_role": "academic discovery and citation landing",
      "internal_link_role": "term_hub",
      "minimum_quality_requirements": ["citation_aware_structure", "source_hierarchy_visible", "terminology_precision", "boundary_section"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_academic_sources_verified"
    },
    {
      "reference_layer_id": "REF_KNOWLEDGE",
      "reference_layer_code": "knowledge",
      "name": "Knowledge reference",
      "purpose": "Clear, reliable general-knowledge reference with controlled simplification and honest uncertainty.",
      "target_users": ["general_readers", "students", "multilingual_learners"],
      "allowed_page_families": ["PT_AUDIENCE_EXPLAINER", "PT_GLOSSARY_CLUSTER", "PT_TERM_CANONICAL", "PT_FOUNDATION"],
      "required_source_posture": "source_verified_for_factual_lines",
      "required_claim_posture": "claim_approved_narrow",
      "allowed_content_classes": ["accessible_explanation", "known_vs_pending_distinction", "terminology_introduction"],
      "forbidden_content_classes": ["false_certainty", "unsupported_facts", "market", "medical", "safety"],
      "seo_role": "general knowledge and explainability",
      "internal_link_role": "audience_hub",
      "minimum_quality_requirements": ["plain_language", "sourced_vs_pending_markers", "no_false_certainty"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_knowledge_boundary_defined"
    },
    {
      "reference_layer_id": "REF_RESEARCH",
      "reference_layer_code": "research",
      "name": "Research reference",
      "purpose": "Deep inquiry support with source/claim mapping, terminology boundaries, and unresolved areas explicit.",
      "target_users": ["researchers", "analysts", "AI_systems"],
      "allowed_page_families": ["PT_TERM_CANONICAL", "PT_DIFFERENCE_COMPARISON", "PT_SOURCE_BOUND", "PT_CLAIM_BOUNDARY", "PT_AI_READABLE", "PT_COMPOUND_ENTITY"],
      "required_source_posture": "source_verified",
      "required_claim_posture": "claim_approved_narrow",
      "allowed_content_classes": ["source_claim_mapping", "terminology_boundary", "comparison", "unresolved_markers", "related_terms"],
      "forbidden_content_classes": ["fabricated_research_conclusions", "unsupported_inference", "medical", "safety"],
      "seo_role": "research intent reference",
      "internal_link_role": "term_hub",
      "minimum_quality_requirements": ["source_claim_map", "boundary_section", "comparison_links_where_applicable"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_research_sources_mapped"
    },
    {
      "reference_layer_id": "REF_EDUCATIONAL",
      "reference_layer_code": "educational",
      "name": "Educational reference",
      "purpose": "Student and child-safe learning reference with vocabulary ladder and safe educational framing.",
      "target_users": ["students", "children", "educators"],
      "allowed_page_families": ["PT_CHILD_SAFE_EDU", "PT_AUDIENCE_EXPLAINER", "PT_GLOSSARY_CLUSTER", "PT_DIFFERENCE_COMPARISON"],
      "required_source_posture": "source_verified",
      "required_claim_posture": "claim_approved_narrow",
      "allowed_content_classes": ["age_appropriate_explanation", "vocabulary_ladder", "naming_awareness", "educational_comparison"],
      "forbidden_content_classes": ["dangerous_experimental_instructions", "medical", "safety_prescriptive", "procurement", "toxicity_detail"],
      "seo_role": "educational discovery",
      "internal_link_role": "education_hub",
      "minimum_quality_requirements": ["child_safe_flag_when_AUD_CHILD_EDU", "vocabulary_level_match", "no_hazard_detail"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_educational_rules_pass"
    },
    {
      "reference_layer_id": "REF_ECONOMIC",
      "reference_layer_code": "economic",
      "name": "Economic reference",
      "purpose": "Economic and strategic context only when source-bound; terminology relevance distinct from market evidence.",
      "target_users": ["investors", "analysts", "companies"],
      "allowed_page_families": ["PT_INVESTOR_ECONOMIC", "PT_COMPANY_INDUSTRY", "PT_DIFFERENCE_COMPARISON", "PT_AUDIENCE_EXPLAINER"],
      "required_source_posture": "source_verified_for_market_lines",
      "required_claim_posture": "claim_approved_with_verified_market_source",
      "allowed_content_classes": ["document_language_in_economic_context", "verified_market_context", "terminology_in_reports"],
      "forbidden_content_classes": ["unsupported_CAGR", "unsupported_pricing", "trade_guidance", "procurement", "acquisition_targeting", "investment_advice"],
      "seo_role": "economic and analyst intent",
      "internal_link_role": "audience_hub",
      "minimum_quality_requirements": ["market_lines_source_bound", "terminology_vs_evidence_distinction"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_only_with_verified_market_sources"
    },
    {
      "reference_layer_id": "REF_INSTITUTIONAL",
      "reference_layer_code": "institutional",
      "name": "Institutional reference",
      "purpose": "Governance, policy, standards, and compliance-aware terminology reference for institutions.",
      "target_users": ["governments", "companies", "standards_readers", "policy_analysts"],
      "allowed_page_families": ["PT_GOVERNMENT_POLICY", "PT_METHODOLOGY_GOVERNANCE", "PT_SOURCE_STATUS", "PT_CLAIM_STATUS", "PT_CORPUS_STATUS", "PT_FOUNDATION"],
      "required_source_posture": "source_verified_for_regulatory_lines",
      "required_claim_posture": "claim_approved_narrow",
      "allowed_content_classes": ["governance_language", "terminology_control", "source_status", "claim_status", "compliance_framing"],
      "forbidden_content_classes": ["unsourced_regulatory_claims", "legal_advice", "safety_prescriptive", "medical"],
      "seo_role": "institutional trust",
      "internal_link_role": "language_hub",
      "minimum_quality_requirements": ["governance_framing", "status_transparency", "no_unsourced_regulatory_claims"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_for_governance_and_policy_cohorts"
    },
    {
      "reference_layer_id": "REF_TECHNICAL",
      "reference_layer_code": "technical",
      "name": "Technical reference",
      "purpose": "Structured technical and machine-readable reference for engineers, data systems, and AI agents.",
      "target_users": ["AI_systems", "engineers", "data_systems", "researchers"],
      "allowed_page_families": ["PT_AI_READABLE", "PT_TERM_CANONICAL", "PT_COMPOUND_ENTITY", "PT_SOURCE_BOUND", "PT_CLAIM_BOUNDARY"],
      "required_source_posture": "source_verified",
      "required_claim_posture": "claim_approved",
      "allowed_content_classes": ["identifiers", "structured_fields", "schema_compatible_blocks", "source_claim_state", "AI_safe_wording"],
      "forbidden_content_classes": ["ambiguous_terminology_mapping", "hallucinated_identifiers", "unsupported_inference"],
      "seo_role": "machine-readable authority",
      "internal_link_role": "AI_reference_hub",
      "minimum_quality_requirements": ["structured_metadata", "provenance_fields", "no_ambiguous_mappings"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_structured_schema_defined"
    },
    {
      "reference_layer_id": "REF_LINGUISTIC",
      "reference_layer_code": "linguistic",
      "name": "Linguistic reference",
      "purpose": "Multilingual terminology, equivalence, non-equivalence, and false-friend prevention across seven languages.",
      "target_users": ["translators", "multilingual_chemists", "researchers", "students"],
      "allowed_page_families": ["PT_MULTILINGUAL_EQUIV", "PT_DIFFERENCE_COMPARISON", "PT_MULTILINGUAL_HUB", "PT_TERM_CANONICAL"],
      "required_source_posture": "source_verified_per_language_line",
      "required_claim_posture": "claim_approved_narrow_per_language",
      "allowed_content_classes": ["language_specific_boundary", "equivalence_notes", "non_equivalence_notes", "false_friend_prevention"],
      "forbidden_content_classes": ["assumed_cross_language_identity_without_source", "universal_suffix_rules", "MT_only_equivalence"],
      "seo_role": "multilingual and hreflang anchor",
      "internal_link_role": "language_hub",
      "minimum_quality_requirements": ["per_language_source", "equivalence_scope_explicit", "hreflang_group_when_indexable"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_multilingual_sources_registered"
    },
    {
      "reference_layer_id": "REF_LOGISTICAL",
      "reference_layer_code": "logistical",
      "name": "Logistical reference",
      "purpose": "Documentation and supply-chain language terminology only when source-bound—not operational instruction.",
      "target_users": ["companies", "logistics_readers", "documentation_specialists"],
      "allowed_page_families": ["PT_COMPANY_INDUSTRY", "PT_AUDIENCE_EXPLAINER", "PT_TERM_CANONICAL", "PT_GLOSSARY_CLUSTER"],
      "required_source_posture": "source_verified",
      "required_claim_posture": "claim_approved_narrow",
      "allowed_content_classes": ["documentation_terminology", "logistics_vocabulary_in_documents", "label_language_context"],
      "forbidden_content_classes": ["transport_guidance", "handling_storage_hazard", "procurement", "pricing", "trade_instructions", "safety_prescriptive"],
      "seo_role": "documentation language reference",
      "internal_link_role": "glossary_hub",
      "minimum_quality_requirements": ["terminology_only_framing", "no_operational_instruction", "source_bound_lines"],
      "indexation_default": "noindex_default",
      "generation_eligibility": "eligible_when_logistics_terminology_sourced"
    }
  ],
  "anti_duplication_rule": "A route may exist only if reference_layer changes structure, purpose, evidence standard, vocabulary level, internal links, or claim boundary versus other routes sharing language, term, audience, or page_type.",
  "comparison_reference_layer_modes": [
    "linguistic_comparison",
    "technical_comparison",
    "educational_comparison",
    "research_comparison",
    "economic_relevance_comparison",
    "institutional_terminology_comparison"
  ]
}
